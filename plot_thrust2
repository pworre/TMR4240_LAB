import pandas as pd
import numpy as np
import matplotlib.pyplot as plt

data = pd.read_csv("allocator_results.csv") #model, Fx_d,Fy_d,Mz_d,Fx_a,Fy_a,Mz_a

plt.figure()
plt.plot(data["Fx_d"], label="Fx demand")
plt.plot(data["Fx_a"], label="Fx achieved", linestyle="--")
plt.legend()

plt.figure()
plt.plot(data["Fy_d"], label="Fy demand")
plt.plot(data["Fy_a"], label="Fy achieved", linestyle="--")
plt.legend()

plt.figure()
plt.plot(data["Mz_d"], label="Mz demand")
plt.plot(data["Mz_a"], label="Mz achieved", linestyle="--")
plt.legend()


counts, bins = np.histogram(data["model"], bins=3)
plt.figure()
plt.stairs(counts, bins)
plt.legend()

plt.figure()
plt.plot(data["model"], label="model")
plt.legend()


plt.show()
